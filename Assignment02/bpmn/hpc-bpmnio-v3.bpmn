<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HPC" targetNamespace="http://hpc.queue.model" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.16.0">
  <collaboration id="Collaboration_HPC">
    <participant id="Pool_HPC" name="HPC Batch Queue System" processRef="Process_HPC" />
  </collaboration>
  <process id="Process_HPC" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_JobSource" name="Job source">
        <flowNodeRef>StartEvent_Arrivals</flowNodeRef>
        <flowNodeRef>Task_SubmitJob</flowNodeRef>
        <flowNodeRef>Gateway_Route</flowNodeRef>
      </lane>
      <lane id="Lane_Short" name="Short partition (t &#60; 1h)">
        <flowNodeRef>EndEvent_BlockShort</flowNodeRef>
        <flowNodeRef>Task_QueueShort</flowNodeRef>
        <flowNodeRef>Gateway_AdmitShort</flowNodeRef>
      </lane>
      <lane id="Lane_Standard" name="Standard partition (t &#60; 48h)">
        <flowNodeRef>EndEvent_BlockStandard</flowNodeRef>
        <flowNodeRef>Task_QueueStandard</flowNodeRef>
        <flowNodeRef>Gateway_AdmitStandard</flowNodeRef>
      </lane>
      <lane id="Lane_Long" name="Long partition (t ≥ 48h)">
        <flowNodeRef>EndEvent_BlockLong</flowNodeRef>
        <flowNodeRef>Task_QueueLong</flowNodeRef>
        <flowNodeRef>Gateway_AdmitLong</flowNodeRef>
      </lane>
      <lane id="Lane_Compute" name="Compute nodes">
        <flowNodeRef>EndEvent_JobDone</flowNodeRef>
        <flowNodeRef>Gateway_0vwca25</flowNodeRef>
        <flowNodeRef>Task_ExecShort</flowNodeRef>
        <flowNodeRef>Task_ExecStandard</flowNodeRef>
        <flowNodeRef>Task_ExecLong</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_Arrivals" name="Job arrivals&#10;A = M(λ)">
      <outgoing>Flow_Start_Submit</outgoing>
    </startEvent>
    <task id="Task_SubmitJob" name="Submit job&#10;(walltime, cores)">
      <incoming>Flow_Start_Submit</incoming>
      <outgoing>Flow_Submit_Route</outgoing>
    </task>
    <endEvent id="EndEvent_BlockShort" name="Blocked (short full)">
      <incoming>Flow_AdmitShort_Block</incoming>
    </endEvent>
    <endEvent id="EndEvent_BlockStandard" name="Blocked (standard full)">
      <incoming>Flow_AdmitStandard_Block</incoming>
    </endEvent>
    <endEvent id="EndEvent_BlockLong" name="Blocked (long full)">
      <incoming>Flow_AdmitLong_Block</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_Arrivals" targetRef="Task_SubmitJob" />
    <sequenceFlow id="Flow_Submit_Route" sourceRef="Task_SubmitJob" targetRef="Gateway_Route" />
    <sequenceFlow id="Flow_Route_Standard" name="t &#60; 1h" sourceRef="Gateway_Route" targetRef="Gateway_AdmitShort" />
    <sequenceFlow id="Flow_Route_Long" name="t ≥ 48h" sourceRef="Gateway_Route" targetRef="Gateway_AdmitLong" />
    <sequenceFlow id="Flow_AdmitShort_Queue" name="admit" sourceRef="Gateway_AdmitShort" targetRef="Task_QueueShort" />
    <sequenceFlow id="Flow_AdmitShort_Block" name="N full" sourceRef="Gateway_AdmitShort" targetRef="EndEvent_BlockShort" />
    <sequenceFlow id="Flow_AdmitStandard_Queue" name="admit" sourceRef="Gateway_AdmitStandard" targetRef="Task_QueueStandard" />
    <sequenceFlow id="Flow_AdmitStandard_Block" name="N full" sourceRef="Gateway_AdmitStandard" targetRef="EndEvent_BlockStandard" />
    <sequenceFlow id="Flow_AdmitLong_Queue" name="admit" sourceRef="Gateway_AdmitLong" targetRef="Task_QueueLong" />
    <sequenceFlow id="Flow_AdmitLong_Block" name="N full" sourceRef="Gateway_AdmitLong" targetRef="EndEvent_BlockLong" />
    <sequenceFlow id="Flow_PromoteStandardToShort" name="aging promotion" sourceRef="Task_QueueStandard" targetRef="Task_QueueShort" />
    <sequenceFlow id="Flow_PromoteLongToStandard" name="aging promotion" sourceRef="Task_QueueLong" targetRef="Task_QueueStandard" />
    <sequenceFlow id="Flow_LongQueue_Exec" sourceRef="Task_QueueLong" targetRef="Task_ExecLong" />
    <task id="Task_QueueShort" name="Short FIFO queue&#10;N=50, max 1h">
      <incoming>Flow_AdmitShort_Queue</incoming>
      <incoming>Flow_PromoteStandardToShort</incoming>
      <outgoing>Flow_0c69qb3</outgoing>
    </task>
    <sequenceFlow id="Flow_0c69qb3" sourceRef="Task_QueueShort" targetRef="Task_ExecShort" />
    <task id="Task_QueueStandard" name="Standard FIFO queue&#10;N=200, max 48h">
      <incoming>Flow_AdmitStandard_Queue</incoming>
      <incoming>Flow_PromoteLongToStandard</incoming>
      <outgoing>Flow_PromoteStandardToShort</outgoing>
      <outgoing>Flow_00cpac2</outgoing>
    </task>
    <task id="Task_QueueLong" name="Long FIFO queue&#10;N=100, no limit">
      <incoming>Flow_AdmitLong_Queue</incoming>
      <outgoing>Flow_LongQueue_Exec</outgoing>
      <outgoing>Flow_PromoteLongToStandard</outgoing>
    </task>
    <sequenceFlow id="Flow_00cpac2" sourceRef="Task_QueueStandard" targetRef="Task_ExecStandard" />
    <exclusiveGateway id="Gateway_Route" name="Route by walltime">
      <incoming>Flow_Submit_Route</incoming>
      <outgoing>Flow_Route_Standard</outgoing>
      <outgoing>Flow_Route_Long</outgoing>
      <outgoing>Flow_1oxfhrv</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_AdmitShort" name="N_short ok?">
      <incoming>Flow_Route_Standard</incoming>
      <outgoing>Flow_AdmitShort_Queue</outgoing>
      <outgoing>Flow_AdmitShort_Block</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_AdmitStandard" name="N_standard ok?">
      <incoming>Flow_1oxfhrv</incoming>
      <outgoing>Flow_AdmitStandard_Queue</outgoing>
      <outgoing>Flow_AdmitStandard_Block</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_AdmitLong" name="N_long ok?">
      <incoming>Flow_Route_Long</incoming>
      <outgoing>Flow_AdmitLong_Queue</outgoing>
      <outgoing>Flow_AdmitLong_Block</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_1oxfhrv" name="t &#60; 48h" sourceRef="Gateway_Route" targetRef="Gateway_AdmitStandard" />
    <sequenceFlow id="Flow_Merge_End" sourceRef="Gateway_0vwca25" targetRef="EndEvent_JobDone" />
    <sequenceFlow id="Flow_ExecLong_Merge" sourceRef="Task_ExecLong" targetRef="Gateway_0vwca25" />
    <sequenceFlow id="Flow_ExecStandard_Merge" sourceRef="Task_ExecStandard" targetRef="Gateway_0vwca25" />
    <sequenceFlow id="Flow_ExecShort_Merge" sourceRef="Task_ExecShort" targetRef="Gateway_0vwca25" />
    <endEvent id="EndEvent_JobDone" name="Job done">
      <incoming>Flow_Merge_End</incoming>
    </endEvent>
    <exclusiveGateway id="Gateway_0vwca25">
      <incoming>Flow_ExecLong_Merge</incoming>
      <incoming>Flow_ExecStandard_Merge</incoming>
      <incoming>Flow_ExecShort_Merge</incoming>
      <outgoing>Flow_Merge_End</outgoing>
    </exclusiveGateway>
    <task id="Task_ExecShort" name="Execute (short)&#10;S=G, c=16 nodes">
      <incoming>Flow_0c69qb3</incoming>
      <outgoing>Flow_ExecShort_Merge</outgoing>
    </task>
    <task id="Task_ExecStandard" name="Execute (standard)&#10;S=G, c=64 nodes">
      <incoming>Flow_00cpac2</incoming>
      <outgoing>Flow_ExecStandard_Merge</outgoing>
    </task>
    <task id="Task_ExecLong" name="Execute (long)&#10;S=G, c=32 nodes">
      <incoming>Flow_LongQueue_Exec</incoming>
      <outgoing>Flow_ExecLong_Merge</outgoing>
    </task>
  </process>
